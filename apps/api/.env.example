# ─── Application ────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Comma-separated list of allowed origins for CORS
CORS_ORIGINS=http://localhost:5173
# debug | info | warn | error
LOG_LEVEL=debug
# Expose Swagger UI at /api/docs (defaults to false in production)
SWAGGER_ENABLED=true
# Rate limiting: max requests per TTL window (ms)
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# ─── Database ───────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=app
DB_SSL=false
DB_LOGGING=false
# Run pending migrations automatically at startup
DB_RUN_MIGRATIONS=true
